extends SceneTree

const Main = preload("res://scripts/main.gd")
var failures: int = 0
var game
var original_bytes: PackedByteArray
var source: Dictionary
var canonical: Dictionary
var path: String
var recordings: Array[WeakRef] = []

class QuietMain:
	extends "res://scripts/main.gd"
	# Fixture-only input hold; production placement and every validation call are real.
	func _capture_game_mouse() -> void: pass

func check(ok: bool, label: String) -> bool:
	if not ok:
		failures += 1
		push_error(label)
	return ok

func _initialize() -> void:
	AudioServer.set_bus_mute(0,true)
	call_deferred("run")

func run() -> void:
	var fixture = OS.get_environment("NULL_CHOIR_TERRAIN_FIXTURE_ROOT")
	var home = fixture.get_base_dir().get_base_dir()+"/home"
	if fixture.is_empty() or ProjectSettings.globalize_path("res://").trim_suffix("/") != fixture or OS.get_environment("HOME") != home or not OS.get_user_data_dir().begins_with(home+"/"):
		print("REFUSED STANDING FIXTURE: explicit disposable project/private HOME required")
		quit(2)
		return
	# Generated by the retained one-second native Intake run; no human save or paths.
	var input = FileAccess.open("res://tests/fixtures/standing_floor_native.json",FileAccess.READ)
	if input == null or input.get_length()>1048576:
		print("REFUSED STANDING SOURCE: missing or oversized fixture")
		quit(2)
		return
	original_bytes = input.get_buffer(input.get_length())
	input.close()
	var parsed = JSON.parse_string(original_bytes.get_string_from_utf8())
	if original_bytes.is_empty() or original_bytes.size()>1048576 or not parsed is Dictionary:
		push_error("Missing or malformed bounded standing fixture")
		quit(2)
		return
	source = parsed
	path = "user://standing_floor_"+str(OS.get_process_id())+"_"+str(Time.get_ticks_usec())+".json"
	var file = null if FileAccess.file_exists(path) else FileAccess.open(path,FileAccess.WRITE)
	if file == null:
		push_error("Cannot create unique private standing fixture copy")
		quit(2)
		return
	file.store_buffer(original_bytes)
	file.close()
	var decoded = Main.Campaign.new()
	check(decoded.from_dict(source),"Unchanged production save codec accepts genuine data")
	canonical = decoded.to_dict()
	game = QuietMain.new()
	game.progress_path = path
	game.settings_path = "user://standing_preferences.json"
	root.add_child(game)
	game.set_process(false)
	game.set_process_unhandled_input(false)
	game.hud.survey.set_physics_process(false)
	await game.continue_campaign()
	if not check(game.playing and not game.placement_pending,"INTENDED RED: actual Main must Continue unchanged genuine standing save"):
		print("STANDING_REFUSAL ",JSON.stringify({"message":game.message,"disk_unchanged":FileAccess.get_file_as_bytes(path)==original_bytes}))
		await finish()
		return
	freeze()
	var crawler = game.enemies.filter(func(a): return a.id=="intake_enemy_01")[0]
	var support: float = game.level.layout.capsule_floor_support(Vector2(crawler.position.x,crawler.position.z),Main.Enemy.capsule_radius(crawler.kind))
	print("STANDING_NATIVE ",JSON.stringify({"safe_margin":crawler.safe_margin,"clearance":crawler.position.y-support,"pose":[crawler.position.x,crawler.position.y,crawler.position.z]}))
	check(is_equal_approx(crawler.safe_margin,.001),"Installed native safe_margin calibration is 0.001m")
	check(game.state.to_dict()==canonical,"Continue retains exact genuine campaign resources and all envelopes")
	for actor in game.enemies:
		var record: Dictionary = canonical.actors.filter(func(a): return a.id==actor.id)[0]
		check(actor.snapshot()==record,"Native actor identity/resources/pose unchanged "+actor.id)
	check(FileAccess.get_file_as_bytes(path)==original_bytes,"Original save remains byte exact")
	await check_contacts(crawler)
	check_invalid_documents()
	await check_recovery_envelopes()
	await check_deep_main_recovery()
	await finish()

func freeze() -> void:
	game.player.set_physics_process(false)
	game.player.set_process_unhandled_input(false)
	for actor in game.enemies: actor.set_physics_process(false)
	if game.music.player.stream != null: recordings.append(weakref(game.music.player.stream))
	game.music.stop()

func finish() -> void:
	game.show_title()
	paused = false
	await create_timer(.1).timeout
	await process_frame
	game.free()
	paused = false
	# Reuse recorded_audio_release's wall-clock wait: headless frames outrun mixer callbacks.
	var deadline = Time.get_ticks_usec()+2000000
	while recordings.any(func(recording): return recording.get_ref()!=null) and Time.get_ticks_usec()<deadline:
		OS.delay_msec(2)
		await process_frame
	check(recordings.all(func(recording): return recording.get_ref()==null),"Every started native MP3 releases before fixture shutdown")
	await process_frame
	await physics_frame
	check(FileAccess.get_file_as_bytes(path)==original_bytes,"No test path writes genuine save")
	print("STANDING_RESULT ",JSON.stringify({"failures":failures}))
	if failures==0: print("PASS native standing floor recovery owned contact/bounds/nonfloor/codec/recovery;")
	quit(0 if failures==0 else 1)

func settle() -> void:
	await physics_frame
	await physics_frame

func raw_contacts(actor) -> Array:
	var collider: CollisionShape3D = actor.get_child(0)
	var query = PhysicsShapeQueryParameters3D.new()
	query.shape = collider.shape
	query.transform = collider.global_transform
	query.collision_mask = 1|4
	query.exclude = [actor.get_rid()]
	return game.level.get_world_3d().direct_space_state.intersect_shape(query,64)

func box(parent: Node3D, size: Vector3, location: Vector3, layer: int) -> StaticBody3D:
	var body = StaticBody3D.new()
	body.collision_layer = layer
	var collider = CollisionShape3D.new()
	var shape = BoxShape3D.new()
	shape.size = size
	collider.shape = shape
	body.add_child(collider)
	parent.add_child(body)
	body.position = location
	return body

func check_contacts(actor) -> void:
	var pose: Vector3 = actor.position
	var margin: float = actor.safe_margin
	var radius: float = actor.get_child(0).shape.radius
	var height: float = actor.get_child(0).shape.height
	var support: float = game.level.layout.capsule_floor_support(Vector2(pose.x,pose.z),radius)
	var state_before: Dictionary = game.state.to_dict()
	check(not raw_contacts(actor).is_empty() and game._valid_restored_actors(),"Real original submillimetre contact is present and accepted")
	actor.position.y = support-.0009
	await settle()
	check(game._valid_restored_actors(),"0.0009m owned floor contact is within calibrated native bound")
	for depth in [.0011,.002,.02]:
		actor.position.y = support-depth
		await settle()
		check(not raw_contacts(actor).is_empty() and not game._valid_restored_actors(),"Deep owned floor contact rejects "+str(depth))
		check(absf(actor.position.y-(support-depth))<.000001,"Rejected floor pose is not clamped")
	actor.safe_margin = .1
	actor.position.y = support-.002
	await settle()
	check(not game._valid_restored_actors(),"Runtime margin changes cannot widen the fixed 0.001m cap")
	actor.position = pose
	actor.safe_margin = 0
	await settle()
	check(not game._valid_restored_actors(),"No contact allowance when native body has zero safe margin")
	actor.safe_margin = margin
	# Mixed and floor-free cases both exercise unmodified-pose strict collision.
	for mixed in [false,true]:
		actor.position = pose if mixed else Vector3(pose.x,support+.03,pose.z)
		await settle()
		check(game._valid_restored_actors(),"Clear setup before nonfloor negatives")
		for kind in ["wall","hero","ceiling","actor-layer","spoofed-floor"]:
			var owner: Node3D = game.level
			if kind=="spoofed-floor":
				owner = MeshInstance3D.new()
				owner.name = "Floor5_5"
				game.level.add_child(owner)
			var location = actor.position+Vector3(radius+.05-.0002,height/2,0)
			if kind=="ceiling": location = actor.position+Vector3(0,height+.05-.0002,0)
			var obstacle = box(owner,Vector3.ONE*.1,location,4 if kind=="actor-layer" else 1)
			obstacle.name = "Floor5_5_col" if kind=="spoofed-floor" else kind
			await settle()
			var hits = raw_contacts(actor)
			check(hits.any(func(hit): return hit.collider==obstacle),"Native tiny nonfloor overlap actually exists: "+kind)
			if mixed: check(hits.any(func(hit): return hit.collider is StaticBody3D and hit.collider in game.level.floor_bodies),"Mixed tiny obstacle plus owned floor actually exists: "+kind)
			check(not game._valid_restored_actors(),"All nonfloor contact rejects: "+kind+" mixed="+str(mixed))
			obstacle.free()
			if owner!=game.level: owner.free()
			await settle()
	actor.position = pose
	await settle()
	var other = game.enemies.filter(func(a): return a!=actor and a.kind=="crawler")[0]
	var other_pose: Vector3 = other.position
	other.position = pose+Vector3(radius*2-.0002,0,0)
	await settle()
	var mixed = raw_contacts(actor)
	check(mixed.any(func(hit): return hit.collider==other) and mixed.any(func(hit): return hit.collider is StaticBody3D and hit.collider in game.level.floor_bodies),"Real Enemy plus owned floor both overlap original capsule")
	check(not game._valid_restored_actors(),"Other real Enemy cannot hide behind admitted floor")
	other.position = other_pose
	await settle()
	var floor_body = raw_contacts(actor)[0].collider
	var mesh = floor_body.get_parent()
	var mesh_name: String = mesh.name
	mesh.name = "RenamedOwnedGeometry"
	check(game._valid_restored_actors(),"Ownership is exact generated node identity, not floor name")
	mesh.name = mesh_name
	mesh.position.y += .02
	await settle()
	check(not game._valid_restored_actors(),"Raised owned mesh cannot evade native corrected-floor query")
	mesh.position.y -= .02
	await settle()
	check(game._valid_restored_actors() and actor.position==pose and other.position==other_pose and game.state.to_dict()==state_before,"All negative probes leave exact native poses/resources untouched")
	print("STANDING_CONTACT_NEGATIVES deep=3 margin_guards=2 tiny_nonfloor=10 mixed_real_enemy=1 ownership=2")

func check_invalid_documents() -> void:
	var before: Dictionary = game.state.to_dict()
	for name in ["current","checkpoint","level_start"]:
		for defect in ["duplicate","future","malformed","nonfinite","negative-hp","deep-floor"]:
			var invalid = canonical.duplicate(true)
			var target: Dictionary = invalid if name=="current" else invalid[name]
			match defect:
				"duplicate": target.actors.append(target.actors[0].duplicate(true))
				"future": invalid.version = 3
				"malformed": target.actors[0].position = [1,2]
				"nonfinite": target.actors[0].position[1] = INF
				"negative-hp": target.actors[0].hp = -1
				"deep-floor": target.actors[0].position[1] = -1000
			var raw = var_to_bytes(invalid)
			check(not game.state.from_dict(invalid) and game.state.to_dict()==before and var_to_bytes(invalid)==raw,"Unchanged atomic data rejection: "+name+" "+defect)
	print("STANDING_CODEC_NEGATIVES envelopes=3 cases=18")

func check_recovery_envelopes() -> void:
	# Controlled snapshot copies of the genuine current records exercise both shared entry points.
	var image: Dictionary = game.state._resources()
	game.state.checkpoint = image.duplicate(true)
	game.state.level_start = image.duplicate(true)
	for boundary in ["checkpoint","restart"]:
		if boundary=="checkpoint": await game.restore_checkpoint()
		else: await game.restart_level()
		check(game.playing and not game.placement_pending,"Native recovery accepts retained genuine standing actors: "+boundary)
		if not game.playing: return
		freeze()
		check(game._valid_restored_actors(),"Reconstructed actors pass shared floor-only bound: "+boundary)
		for actor in game.enemies:
			var record: Dictionary = image.actors.filter(func(a): return a.id==actor.id)[0]
			check(actor.snapshot()==record,"Recovery retains exact genuine actor record: "+boundary+" "+actor.id)
		check(game.state._resources()==image,"Recovery resources retain controlled unchanged image: "+boundary)
	print("STANDING_RECOVERY current=real_saved_continue checkpoint=controlled_copy restart=controlled_copy")

func check_deep_main_recovery() -> void:
	var image: Dictionary = game.state.to_dict()
	var actor: Dictionary = image.actors.filter(func(a): return a.id=="intake_enemy_01")[0]
	var support: float = game.level.layout.capsule_floor_support(Vector2(actor.position[0],actor.position[2]),Main.Enemy.capsule_radius("crawler"))
	actor.position[1] = support-.002
	check(game.state.from_dict(image),"Deep native floor counterexample passes unchanged static codec tolerance")
	game.loaded_positions = true
	await game.start_level()
	check(not game.playing and not game.placement_pending and game.message=="NO SAFE RECOVERY POSITION","Actual Main refuses deeper 0.002m actor floor overlap")
	print("STANDING_DEEP_MAIN rejected=true depth=0.002 disk_unchanged=",FileAccess.get_file_as_bytes(path)==original_bytes)
