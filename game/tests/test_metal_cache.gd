extends SceneTree
const Main = preload("res://scripts/main.gd")
func _initialize():
	var game = Main.new()
	if not game.has_method("_has_metal_shader_cache"):
		game.free()
		push_error("INTENDED RED: packed cache acceptance must require actual nested Metal cache files")
		quit(1)
		return
	var root = "user://metal_cache_fixture_"+str(Time.get_ticks_usec())
	assert(not game._has_metal_shader_cache(root))
	assert(DirAccess.make_dir_recursive_absolute(root+"/Shader/variant") == OK)
	assert(not game._has_metal_shader_cache(root))
	var other = FileAccess.open(root+"/Shader/variant/only.vulkan.cache",FileAccess.WRITE)
	other.store_string("filename fixture, not compiled shader evidence")
	other.close()
	assert(not game._has_metal_shader_cache(root))
	var metal = FileAccess.open(root+"/Shader/variant/actual.metal.cache",FileAccess.WRITE)
	metal.store_string("filename fixture, not compiled shader evidence")
	metal.close()
	assert(game._has_metal_shader_cache(root))
	assert(DirAccess.remove_absolute(root+"/Shader/variant/actual.metal.cache") == OK)
	assert(DirAccess.remove_absolute(root+"/Shader/variant/only.vulkan.cache") == OK)
	assert(DirAccess.remove_absolute(root+"/Shader/variant") == OK)
	assert(DirAccess.remove_absolute(root+"/Shader") == OK)
	assert(DirAccess.remove_absolute(root) == OK)
	game.free()
	print("PASS native cache guard missing, empty, non-Metal and nested Metal filename boundaries")
	quit()
